# Postgres — local Docker or a Neon/Supabase free-tier URL
DATABASE_URL=

# From console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Model IDs — check platform.claude.com/docs/en/about-claude/models before first run
MODEL_STRONG=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001

# Per-million-token prices in USD, used only for the cost column in llm_calls
PRICE_STRONG_INPUT=3
PRICE_STRONG_OUTPUT=15
PRICE_FAST_INPUT=1
PRICE_FAST_OUTPUT=5
USD_INR=84

# Adapters — only "mock" exists in v1
ADS_PROVIDER=mock
SEARCH_PROVIDER=mock

# Any random string; the cron route checks it in a header
CRON_SECRET=change-me-to-a-long-random-string

# Optional: set both to password-protect a hosted deployment (e.g. a public resume/portfolio
# link) with a single shared passcode. Leave both unset for local dev — the gate is then off.
# See middleware.ts and app/gate/page.tsx.
DEMO_PASSWORD=
DEMO_AUTH_SECRET=